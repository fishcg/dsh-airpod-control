{
  "name": "dsh-airpod-control",
  "version": "0.2.0",
  "description": "Control DeepSeek Harness from AirPods head gestures (via HeadOrbit): nod = allow / confirm, shake = reject / next option. Ships a one-click installer for the menu-bar app.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "scripts": {
    "test": "node --test test/plugin.test.js"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.1 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "airpods",
    "head-gesture",
    "accessibility",
    "voice-control",
    "macos",
    "approval"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fishcg/dsh-airpod-control.git"
  },
  "homepage": "https://github.com/fishcg/dsh-airpod-control#readme",
  "bugs": {
    "url": "https://github.com/fishcg/dsh-airpod-control/issues"
  }
}
